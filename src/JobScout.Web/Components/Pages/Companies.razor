@page "/companies"
@rendermode InteractiveServer
@using JobScout.Core.Services
@using JobScout.Web.Services
@inject IDbContextFactory<JobScoutDbContext> DbFactory
@inject JobScheduler Scheduler
@inject Display Fmt

<PageTitle>Companies - JobScout</PageTitle>

<h1>Companies</h1>
<p class="page-sub">
    USE companies are scanned every morning. REVIEW companies came from a job board and are
    waiting for your decision. NOT_USE companies are kept so they are not rediscovered endlessly.
</p>

@if (_message is not null)
{
    <div class="alert ok">@_message</div>
}
@if (_error is not null)
{
    <div class="alert bad">@_error</div>
}

<div class="card">
    <h3>Add a company</h3>
    <div class="toolbar">
        <div class="field">
            <label for="new-name">Name</label>
            <input id="new-name" type="text" style="width:240px" @bind="_newName" @bind:event="oninput" />
        </div>
        <div class="field">
            <label for="new-url">Careers page URL</label>
            <input id="new-url" type="url" style="width:340px" placeholder="https://example.com/careers"
                   @bind="_newUrl" @bind:event="oninput" />
        </div>
        <div class="field">
            <label for="new-status">Status</label>
            <select id="new-status" @bind="_newStatus">
                @foreach (var status in Enum.GetValues<CompanyStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <button class="primary" disabled="@(!CanAdd)" @onclick="AddCompany">Add</button>
    </div>
</div>

<div class="toolbar">
    <div class="field">
        <label for="f-status">Status</label>
        <select id="f-status" value="@_filterStatus" @onchange="OnFilterChanged">
            <option value="">All</option>
            @foreach (var status in Enum.GetValues<CompanyStatus>())
            {
                <option value="@status">@status</option>
            }
            <option value="needs-url">Needs careers URL</option>
        </select>
    </div>
    <div class="field">
        <label for="f-search">Search</label>
        <input id="f-search" type="text" value="@_search" @oninput="OnSearchChanged" />
    </div>
</div>

@if (_loading)
{
    <div class="empty">Loading&hellip;</div>
}
else if (_rows.Count == 0)
{
    <div class="card empty">
        No companies match. Add one above, or run discovery from <a href="/runs">Job runs</a>
        to find some from the job boards.
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Status</th>
                    <th style="min-width:280px">Careers URL</th>
                    <th>Board</th>
                    <th>Source</th>
                    <th style="width:70px">Jobs</th>
                    <th>Last checked</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>
                            @row.Name
                            @if (row.NeedsUrl)
                            {
                                <span class="badge warn" style="margin-left:6px">needs careers URL</span>
                            }
                        </td>
                        <td>
                            <select value="@row.Status" @onchange="e => ChangeStatus(row.Id, e)">
                                @foreach (var status in Enum.GetValues<CompanyStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input type="url" style="width:100%" placeholder="https://..."
                                   value="@row.Url"
                                   @onchange="e => SaveUrl(row.Id, e)" />
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrWhiteSpace(row.BoardUrl))
                            {
                                <a href="@row.BoardUrl" target="_blank" rel="noopener noreferrer nofollow">
                                    @Display.HostOf(row.BoardUrl) &nearr;
                                </a>
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                        <td class="small muted">@row.Source</td>
                        <td class="small">
                            @if (row.ListingCount > 0)
                            {
                                <a href="/jobs?company=@row.Id">@row.ListingCount</a>
                            }
                            else
                            {
                                <span class="muted">0</span>
                            }
                        </td>
                        <td class="small muted">@Display.Relative(row.LastCheckedAt)</td>
                        <td>
                            <button class="danger" title="Delete this company and its listings"
                                    @onclick="() => Delete(row.Id)">Del</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private string? _message;
    private string? _error;

    private string _newName = string.Empty;
    private string _newUrl = string.Empty;
    private CompanyStatus _newStatus = CompanyStatus.USE;

    private string _filterStatus = string.Empty;
    private string _search = string.Empty;

    private List<Row> _rows = [];

    private bool CanAdd => !string.IsNullOrWhiteSpace(_newName);

    [SupplyParameterFromQuery(Name = "filter")]
    private string? FilterFromQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(FilterFromQuery))
            _filterStatus = FilterFromQuery;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        await using var db = await DbFactory.CreateDbContextAsync();

        var query = db.Companies.AsNoTracking().AsQueryable();

        if (_filterStatus == "needs-url")
            query = query.Where(c => c.Status == CompanyStatus.USE && (c.Url == null || c.Url == ""));
        else if (Enum.TryParse<CompanyStatus>(_filterStatus, out var status))
            query = query.Where(c => c.Status == status);

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            query = query.Where(c => EF.Functions.Like(c.Name, $"%{term}%"));
        }

        _rows = await query
            .OrderBy(c => c.Status == CompanyStatus.REVIEW ? 0 : 1)
            .ThenBy(c => c.Name)
            .Select(c => new Row(
                c.Id, c.Name, c.Status, c.Url, c.BoardUrl, c.Source,
                c.LastCheckedAt, c.Listings.Count))
            .ToListAsync();

        _loading = false;
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        _filterStatus = e.Value?.ToString() ?? string.Empty;
        await LoadAsync();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        await LoadAsync();
    }

    private async Task AddCompany()
    {
        _message = _error = null;

        var normalised = CompanyNameNormaliser.Normalise(_newName);
        if (normalised.Length == 0)
        {
            _error = "That name does not produce a usable key. Try a longer name.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if (await db.Companies.AnyAsync(c => c.NormalisedName == normalised))
        {
            _error = $"'{_newName}' is already on the list.";
            return;
        }

        db.Companies.Add(new Company
        {
            Name = _newName.Trim(),
            NormalisedName = normalised,
            Url = string.IsNullOrWhiteSpace(_newUrl) ? null : _newUrl.Trim(),
            Source = "Manual",
            Status = _newStatus,
            DiscoveredAt = DateTimeOffset.UtcNow,
        });

        await db.SaveChangesAsync();

        _message = $"Added {_newName.Trim()}.";
        _newName = _newUrl = string.Empty;
        _newStatus = CompanyStatus.USE;

        await LoadAsync();
    }

    private async Task ChangeStatus(int companyId, ChangeEventArgs e)
    {
        _message = _error = null;

        if (!Enum.TryParse<CompanyStatus>(e.Value?.ToString(), out var newStatus)) return;

        string companyName;
        bool queueScoring;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var company = await db.Companies.FirstOrDefaultAsync(c => c.Id == companyId);
            if (company is null) return;

            var wasUse = company.Status == CompanyStatus.USE;
            company.Status = newStatus;
            await db.SaveChangesAsync();

            companyName = company.Name;

            // Moving a company to USE is what unlocks scoring for the listings that
            // discovery already saved.
            queueScoring = newStatus == CompanyStatus.USE && !wasUse;

            if (queueScoring)
            {
                queueScoring = await db.JobListings
                    .AnyAsync(l => l.CompanyId == companyId && l.Score == null);
            }
        }

        if (queueScoring)
        {
            Scheduler.QueueCompanyScoring(companyId, companyName);
            _message = $"{companyName} set to USE. Scoring its unscored listings now - see Job runs.";
        }
        else
        {
            _message = $"{companyName} set to {newStatus}.";
        }

        await LoadAsync();
    }

    private async Task SaveUrl(int companyId, ChangeEventArgs e)
    {
        _message = _error = null;

        var url = e.Value?.ToString()?.Trim();

        if (!string.IsNullOrWhiteSpace(url) &&
            (!Uri.TryCreate(url, UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https")))
        {
            _error = "That does not look like an http(s) URL.";
            await LoadAsync();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var company = await db.Companies.FirstOrDefaultAsync(c => c.Id == companyId);
        if (company is null) return;

        company.Url = string.IsNullOrWhiteSpace(url) ? null : url;
        await db.SaveChangesAsync();

        _message = $"Careers URL saved for {company.Name}.";
        await LoadAsync();
    }

    private async Task Delete(int companyId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var company = await db.Companies.FirstOrDefaultAsync(c => c.Id == companyId);
        if (company is null) return;

        var name = company.Name;
        db.Companies.Remove(company);
        await db.SaveChangesAsync();

        _message = $"Deleted {name} and its listings. Applications you already recorded are kept.";
        await LoadAsync();
    }

    private sealed record Row(
        int Id, string Name, CompanyStatus Status, string? Url, string? BoardUrl,
        string Source, DateTimeOffset? LastCheckedAt, int ListingCount)
    {
        public bool NeedsUrl => Status == CompanyStatus.USE && string.IsNullOrWhiteSpace(Url);
    }
}
